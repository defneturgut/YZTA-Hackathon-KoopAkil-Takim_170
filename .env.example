# =====================================================================
# KoopAkıl — Root .env  (DOCKER-COMPOSE BU DOSYAYI OKUR)
# =====================================================================
#
# ⚠️  ÖNEMLİ:  Bu dosyayı `.env` adıyla kopyalayın:
#         cp .env.example .env
#
#     Sonra GEMINI_API_KEY satırını düzenleyin.
#     `backend/.env.example` dosyası Docker tarafından OKUNMAZ.
#     API key buraya, bu dosyaya konmalı.
#
# =====================================================================

# ============== 🤖 GEMINI API KEY — BURAYI DOLDURUN ==================
# https://ai.google.dev adresinden ücretsiz key alın.
# Geçerli key 'AIza' ile başlar ve > 20 karakterdir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=text-embedding-004

# Key boş bırakılırsa otomatik mock moda düşer (network çağrısı yok).
# Key varsa otomatik gerçek Gemini'ye geçer; AI_DEMO_MODE göz ardı edilir.
AI_DEMO_MODE=false
# =====================================================================

# ----- Postgres ------------------------------------------------------
POSTGRES_DB=aegis_kobi
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis

# ----- Backend -------------------------------------------------------
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost
SEED_ON_STARTUP=true

# ----- Frontend ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
