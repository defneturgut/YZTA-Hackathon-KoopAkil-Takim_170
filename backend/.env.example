# ============================================
# KoopAkıl — Backend Environment Variables
# ============================================

# Application
APP_NAME="KoopAkıl"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Security
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (default: SQLite for zero-config demo. Switch to Postgres in docker-compose.)
DATABASE_URL=sqlite+aiosqlite:///./koopakil.db
# DATABASE_URL=postgresql+asyncpg://koopakil:koopakil@postgres:5432/koopakil

# Redis (optional in demo — falls back to in-memory if unavailable)
REDIS_URL=redis://redis:6379/0

# AI / Gemini
# Set GEMINI_API_KEY to use real Gemini 2.5 Pro.
# Leave GEMINI_API_KEY empty to run in mock/demo mode (no network calls).
# The AI_DEMO_MODE flag is kept only for backwards compat — key presence wins.
AI_DEMO_MODE=false
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBED_MODEL=text-embedding-004

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed data on first boot (only writes if tables are empty — never overwrites)
SEED_ON_STARTUP=true
